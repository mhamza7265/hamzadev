// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
}

model User {
  id                String          @id @default(cuid())
  name              String?
  email             String          @unique
  emailVerified     DateTime?
  image             String?
  password          String
  role              Role            @default(ADMIN)
  accounts          Account[]
  sessions          Session[]
  resetToken      String?           @unique
  resetTokenExpiresAt  DateTime?
}

model Account {
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken        String    @unique
  userId              String
  expires             DateTime
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier          String
  token               String    @unique
  expires             DateTime

  @@unique([identifier, token])
}

enum SkillCategory {
  Frontend
  Backend
  Cloud_DevOps
}

enum SkillTag {
  Advanced
  Expert
  Proficient
  Intermediate
}

model Skill {
  id                  Int       @id @default(autoincrement())
  name                String
  category            SkillCategory
  tag                 SkillTag
  experience          ExperienceSkill[]
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  tagline     String
  description String

  codePreviewName String?
  previewCode  String?  @db.Text
  codeLanguage  String?

  liveUrl     String?
  repoUrl     String?

  clientProject Boolean @default(false)
  accent        String?
  icon          String?

  technologies ProjectTechnology[]
  features     ProjectFeature[]
  highlights   ProjectHighlight[]

  sortOrder     Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTechnology {
  id          Int      @id @default(autoincrement())
  name        String
  projectId   Int
  sortOrder   Int  @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectFeature {
  id        Int      @id @default(autoincrement())
  content   String
  projectId Int
  sortOrder     Int  @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectHighlight {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  projectId Int
  sortOrder     Int  @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Profile {
  id                      Int     @id @default(autoincrement())
  name                    String
  firstName               String
  professionalTitle       String
  tagline                 String
  location                String
  email                   String
  github                  String
  linkedin                String
  resumeLink              String
}

enum AnalyticsEventName {
  page_view
  github_click
  linkedin_click
  email_click
  project_demo_click
  project_case_study_click
  project_github_click
  project_live_url_click
  generate_lead
}

model AnalyticsEvent {
  id String @id @default(cuid())

  // Prevent duplicate event submissions
  eventId String @unique

  event AnalyticsEventName

  // Anonymous identifiers
  visitorId String
  sessionId String

  // Page/event context
  path      String?
  referrer  String?
  title     String?

  // Optional event-specific information
  projectId String?
  metadata  Json?

  // Basic visitor information
  country String?
  city    String?
  device  String?
  browser String?
  os      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
}

model Experience {
  id             Int                     @id @default(autoincrement())
  jobTitle       String
  jobSummary     String
  employer       String
  location       String
  startDate      Int
  endDate        Int?
  isContinued    Boolean                 @default(false)
  stack          ExperienceSkill[]
  sortOrder      Int                     @default(0)
  bullets        ExperienceBullet[]
}

model ExperienceBullet {
  id           Int        @id @default(autoincrement())
  experienceId Int
  description  String
  sortOrder    Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model ExperienceSkill {
  experienceId Int
  skillId      Int
  sortOrder    Int         @default(0)

  experience   Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
}